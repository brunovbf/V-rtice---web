---
/**
 * Sello al pie de las 4 demos: chevron + "Demo creada por Vértice", linkeando
 * a la landing. Es una de las tres unicas cosas que las demos comparten.
 */
interface Props {
  /** Color del chevron, distinto en cada demo. */
  color: string;
  /** Color del texto, ya con la opacidad de cada paleta. */
  textColor: string;
}
const { color, textColor } = Astro.props;
---

<a class="seal" href="/" style={`color:${textColor}`}>
  <svg
    width="14"
    height="14"
    viewBox="0 0 32 32"
    fill="none"
    stroke={color}
    stroke-width="4.5"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <polyline points="6 21 16 10 26 21"></polyline>
  </svg>
  Demo creada por Vértice
</a>

<style>
  .seal {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: var(--fs-sm);
  }
</style>
