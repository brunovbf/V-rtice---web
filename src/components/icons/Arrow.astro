---
/** Flecha a la derecha de los CTA. */
interface Props {
  size?: number;
  color?: string;
  width?: number;
}
const { size = 17, color = 'currentColor', width = 2.6 } = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke={color}
  stroke-width={width}
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  <line x1="5" y1="12" x2="19" y2="12"></line>
  <polyline points="12 5 19 12 12 19"></polyline>
</svg>
