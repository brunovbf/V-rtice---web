---
/**
 * Mockup de navegador: barra con los tres puntos, pastilla de URL opcional y
 * la captura debajo. Se usa en el hero, en el servicio estrella, en la demo
 * destacada y en el modal.
 */
import { Image } from 'astro:assets';

interface Props {
  src: ImageMetadata;
  alt: string;
  /** Texto de la pastilla de URL. Sin esto la barra va solo con los puntos. */
  url?: string;
  /** Tamano de los puntos: el hero usa 11px, el resto 9-10px. */
  dot?: number;
  ratio?: string;
  /** El hero y los mockups del modal van rotados -2deg. */
  rotate?: boolean;
  radius?: string;
  background?: string;
  widths?: number[];
  sizes?: string;
  class?: string;
  /**
   * Por defecto `top`: es un mockup de navegador, asi que cuando la captura no
   * calza justo con el contenedor conviene perder el pie y no el encabezado.
   * Hoy las 4 capturas de demo son 16/10 exactas y no hay recorte, pero esto
   * queda como red de seguridad para cuando se retome alguna con otro encuadre.
   */
  objectPosition?: string;
  /**
   * Cuando arranca la descarga. `<Image>` de Astro pone `loading="lazy"` por
   * defecto, que sirve para el caso comun pero rompe en los dos extremos:
   *
   *   'lazy'   (default) mockup en el flujo y debajo del pliegue: que espere.
   *   'hero'   arriba del pliegue. En lazy el escaner de precarga no descubre
   *            la imagen y el visitante ve el recuadro vacio: es el LCP
   *            llegando tarde. Va eager y con prioridad alta.
   *   'hidden' dentro de un overlay con [hidden]. Un elemento en display:none
   *            no genera caja, asi que nunca intersecta el viewport y el lazy
   *            no dispara NUNCA: la descarga arranca recien al abrir el modal
   *            y la foto aparece despues de la tarjeta. Va eager para ignorar
   *            la visibilidad, y con prioridad baja para no pelearle la cola
   *            de red al hero.
   */
  load?: 'lazy' | 'hero' | 'hidden';
}

const LOAD = {
  lazy: { loading: 'lazy', fetchpriority: 'auto' },
  hero: { loading: 'eager', fetchpriority: 'high' },
  hidden: { loading: 'eager', fetchpriority: 'low' },
} as const;

const {
  src,
  alt,
  url,
  dot = 10,
  ratio = '16/10',
  rotate = false,
  radius = 'var(--r-mock)',
  background = 'var(--surface)',
  widths = [560, 860, 1180],
  sizes = '(max-width: 860px) 100vw, 620px',
  class: className,
  objectPosition = 'top',
  load = 'lazy',
} = Astro.props;
---

<figure
  class:list={['mock', { 'mock--rot': rotate }, className]}
  style={`--dot:${dot}px; --ratio:${ratio}; --mock-r:${radius}; --mock-bg:${background}; --obj-pos:${objectPosition};`}
>
  <div class="mock__bar">
    <span class="mock__dot" style="background:#ff5f57"></span>
    <span class="mock__dot" style="background:#febc2e"></span>
    <span class="mock__dot" style="background:#28c840"></span>
    {url && <span class="mock__url">{url}</span>}
  </div>
  <Image
    src={src}
    alt={alt}
    widths={widths}
    sizes={sizes}
    class="mock__img"
    loading={LOAD[load].loading}
    fetchpriority={LOAD[load].fetchpriority}
  />
</figure>

<style>
  .mock {
    position: relative;
    margin: 0;
    background: var(--mock-bg);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: var(--mock-r);
    overflow: hidden;
    box-shadow: var(--sh-mock-hero);
  }

  .mock--rot {
    transform: rotate(-2deg);
  }

  .mock__bar {
    display: flex;
    align-items: center;
    gap: 7px;
    padding: 12px 15px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.07);
  }

  .mock__dot {
    width: var(--dot);
    height: var(--dot);
    border-radius: 50%;
    flex: none;
  }

  .mock__url {
    margin-left: 10px;
    font-size: var(--fs-xs);
    color: var(--text-min);
    background: var(--bg);
    padding: 5px 12px;
    border-radius: 6px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .mock__img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: var(--ratio);
    object-fit: cover;
    object-position: var(--obj-pos, top);
  }

  @media (max-width: 560px) {
    .mock__url {
      font-size: var(--fs-2xs);
      padding: 4px 9px;
    }
  }
</style>
