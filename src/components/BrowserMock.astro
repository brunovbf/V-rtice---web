---
/**
 * Mockup de navegador: barra con los tres puntos, pastilla de URL opcional y
 * la captura debajo. Se usa en el hero, en el servicio estrella, en la demo
 * destacada y en el modal.
 */
import { Image } from 'astro:assets';

interface Props {
  src: ImageMetadata;
  alt: string;
  /** Texto de la pastilla de URL. Sin esto la barra va solo con los puntos. */
  url?: string;
  /** Tamano de los puntos: el hero usa 11px, el resto 9-10px. */
  dot?: number;
  ratio?: string;
  /** El hero y los mockups del modal van rotados -2deg. */
  rotate?: boolean;
  radius?: string;
  background?: string;
  widths?: number[];
  sizes?: string;
  credit?: string;
  creditHref?: string;
  class?: string;
  /**
   * Por defecto `top`: es un mockup de navegador, asi que cuando la captura no
   * calza justo con el contenedor conviene perder el pie y no el encabezado.
   * La captura de veterinaria es 1.467 y el contenedor 16/10, asi que sin esto
   * el recorte se come la barra de navegacion del sitio de la demo.
   */
  objectPosition?: string;
}

const {
  src,
  alt,
  url,
  dot = 10,
  ratio = '16/10',
  rotate = false,
  radius = 'var(--r-mock)',
  background = 'var(--surface)',
  widths = [560, 860, 1180],
  sizes = '(max-width: 860px) 100vw, 620px',
  credit,
  creditHref,
  class: className,
  objectPosition = 'top',
} = Astro.props;
---

<figure
  class:list={['mock', { 'mock--rot': rotate }, className]}
  style={`--dot:${dot}px; --ratio:${ratio}; --mock-r:${radius}; --mock-bg:${background}; --obj-pos:${objectPosition};`}
>
  <div class="mock__bar">
    <span class="mock__dot" style="background:#ff5f57"></span>
    <span class="mock__dot" style="background:#febc2e"></span>
    <span class="mock__dot" style="background:#28c840"></span>
    {url && <span class="mock__url">{url}</span>}
  </div>
  <Image src={src} alt={alt} widths={widths} sizes={sizes} class="mock__img" />
  {
    credit && (
      <figcaption class="mock__credit">
        {creditHref ? (
          <a href={creditHref} target="_blank" rel="noopener nofollow">
            {credit}
          </a>
        ) : (
          credit
        )}
      </figcaption>
    )
  }
</figure>

<style>
  .mock {
    position: relative;
    margin: 0;
    background: var(--mock-bg);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: var(--mock-r);
    overflow: hidden;
    box-shadow: var(--sh-mock-hero);
  }

  .mock--rot {
    transform: rotate(-2deg);
  }

  .mock__bar {
    display: flex;
    align-items: center;
    gap: 7px;
    padding: 12px 15px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.07);
  }

  .mock__dot {
    width: var(--dot);
    height: var(--dot);
    border-radius: 50%;
    flex: none;
  }

  .mock__url {
    margin-left: 10px;
    font-size: 12px;
    color: var(--text-min);
    background: var(--bg);
    padding: 5px 12px;
    border-radius: 6px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .mock__img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: var(--ratio);
    object-fit: cover;
    object-position: var(--obj-pos, top);
  }

  /* Atribucion de Unsplash: visible pero discreta. */
  .mock__credit {
    position: absolute;
    bottom: 0;
    right: 0;
    font-size: 10px;
    line-height: 1;
    padding: 5px 8px;
    color: rgba(255, 255, 255, 0.55);
    background: rgba(6, 5, 12, 0.6);
    border-top-left-radius: 6px;
  }

  @media (max-width: 560px) {
    .mock__url {
      font-size: 10.5px;
      padding: 4px 9px;
    }
  }
</style>
