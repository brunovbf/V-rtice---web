---
import Chevron from '../icons/Chevron.astro';
import Check from '../icons/Check.astro';
import { sobreMi, mostrarFotoBruno } from '../../data/landing';

// PASO 2: descomentar estas dos lineas junto con el <Image> de abajo.
// import { Image } from 'astro:assets';
// import bruno from '../../assets/bruno.jpg';

/**
 * La foto vive detras de `mostrarFotoBruno` (src/data/landing.ts), que ahi
 * documenta los 3 pasos para activarla. Mientras este en false la seccion va
 * a una sola columna: sin foto, el texto es el protagonista y no queda un
 * recuadro vacio anunciando lo que falta.
 */
---

<section id="sobre" class="about container">
  <div class:list={['reveal', 'about__grid', { 'about__grid--solo': !mostrarFotoBruno }]}>
    {
      mostrarFotoBruno && (
        <div class="about__media">
          <div class="about__glow" aria-hidden="true" />
          <div class="about__frame">
            {/* PASO 2: descomentar tambien esta linea. */}
            {/* <Image src={bruno} alt="Bruno, de Vértice" widths={[340, 520]} class="about__img" /> */}
          </div>
        </div>
      )
    }

    <div>
      <p class="eyebrow">
        <Chevron size={16} />
        Sobre mí
      </p>
      <h2 class="t-h2 about__title">Hola, soy <span class="grad">Bruno</span></h2>

      <p class="about__p">
        Trabajo en administración y análisis de datos en el sector empresarial uruguayo. Esa
        experiencia me enseñó qué necesitan los negocios: soluciones que funcionen, fáciles de usar
        y que ahorren tiempo real.
      </p>
      <p class="about__p">
        Con Vértice llevo esas herramientas a comercios y profesionales que quieren dar el salto
        digital. Cada proyecto lo trabajo yo, de principio a fin: hablás siempre conmigo y sabés
        exactamente qué recibís.
      </p>

      <ul class="about__bullets">
        {
          sobreMi.map((s) => (
            <li>
              <span class="check__box">
                <Check />
              </span>
              {s}
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .about {
    margin-top: 80px;
  }

  .about__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: 52px;
    align-items: center;
  }

  /*
   * Sin foto no hay dos columnas: una sola, alineada a la izquierda y con el
   * ancho acotado para que la medida de lectura no se estire.
   */
  .about__grid--solo {
    grid-template-columns: minmax(0, 1fr);
    max-width: 720px;
  }

  .about__media {
    position: relative;
  }

  .about__glow {
    position: absolute;
    inset: -30px;
    background: radial-gradient(circle at 40% 40%, rgba(124, 92, 255, 0.32), transparent 62%);
    filter: blur(28px);
    pointer-events: none;
  }

  .about__frame {
    position: relative;
    border-radius: var(--r-pack);
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.1);
    box-shadow: 0 34px 74px -30px rgba(124, 92, 255, 0.5);
    transform: rotate(-2deg);
  }

  .about__frame :global(.about__img) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4/5;
    object-fit: cover;
  }

  /*
   * Sin font-size propio a proposito: es un h2 y usa la escalera de `.t-h2`
   * (44/36/30) como todos los demas. Antes lo pisaba con 40/34/28, tres
   * tamanos a pocos px de los del rol, sin razon. Aca solo va el margen.
   */
  .about__title {
    margin-bottom: 22px;
  }

  .about__p {
    font-size: var(--fs-lg);
    line-height: 1.7;
    color: var(--text-dim);
    margin-bottom: 18px;
    max-width: 560px;
    text-wrap: pretty;
  }

  .about__p:last-of-type {
    margin-bottom: 28px;
  }

  .about__bullets {
    display: flex;
    gap: 26px;
    flex-wrap: wrap;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .about__bullets li {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: var(--fs-md);
    color: var(--text-soft);
  }

  @media (max-width: 1024px) {
    .about__grid {
      grid-template-columns: 1fr;
      gap: 34px;
    }

    .about__media {
      max-width: 340px;
    }
  }
</style>
