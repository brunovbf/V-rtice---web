---
import Check from '../icons/Check.astro';
import Arrow from '../icons/Arrow.astro';
import ChevronNumber from '../ChevronNumber.astro';
import { packs, rubrosPacks } from '../../data/servicios';
---

<div class="reveal packs">
  <div class="sec-mark packs__mark">
    <span class="sec-mark__title">Packs de planillas</span>
    <span class="sec-mark__rule"></span>
    <span class="sec-mark__note">Adaptado a tu rubro</span>
  </div>

  <h3 class="packs__title">Un sistema de gestión completo para tu negocio</h3>
  <p class="packs__lead">Pago único, sin suscripciones y con puesta en marcha incluida.</p>

  <div class="packs__grid">
    {
      packs.map((p) => (
        <div class="pack">
          {p.star && <span class="pack__badge">MÁS ELEGIDO</span>}

          <div class="pack__head">
            <ChevronNumber num={p.n} size={56} fontSize={17} />
            <div>
              <h4 class="pack__name">{p.title}</h4>
              <p class="pack__sub">{p.sub}</p>
            </div>
          </div>

          <div class="pack__pricing">
            <span class="pack__price">{p.price}</span>
            <span class="pack__usd">pago único · {p.usd}</span>
          </div>

          <div class="checks pack__checks">
            {p.items.map((it) => (
              <div class="check pack__check">
                <span class="check__box">
                  <Check />
                </span>
                {it}
              </div>
            ))}
          </div>

          <a class="btn btn--soft pack__cta" href={p.wa}>
            Quiero este pack
            <Arrow size={16} color="#B98CFF" />
          </a>
        </div>
      ))
    }
  </div>

  <div class="packs__rubros">
    <span class="packs__rubros-label">Disponible para:</span>
    {rubrosPacks.map((r) => <span class="chip chip--sm">{r}</span>)}
  </div>
</div>

<style>
  /* Sin separador arriba: se saco a proposito. */
  .packs {
    margin-top: 96px;
  }

  .packs__mark {
    margin-bottom: 28px;
  }

  .packs__title {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 32px;
    letter-spacing: -1px;
    margin-bottom: 8px;
    max-width: 620px;
    text-wrap: balance;
  }

  .packs__lead {
    font-size: var(--fs-base);
    color: var(--text-dim);
    margin-bottom: 32px;
    max-width: 560px;
    text-wrap: pretty;
  }

  .packs__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 22px;
  }

  .pack {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: 34px 32px;
    border-radius: var(--r-pack);
    border: 1px solid rgba(124, 92, 255, 0.3);
    background: var(--surface-raised);
    box-shadow: 0 26px 60px -30px rgba(124, 92, 255, 0.45);
  }

  .pack__badge {
    position: absolute;
    top: -12px;
    left: 32px;
    background: var(--green);
    color: var(--bg);
    padding: 5px 13px;
    border-radius: var(--r-pill);
    font-size: var(--fs-2xs);
    font-weight: 700;
    letter-spacing: 0.4px;
  }

  .pack__head {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 18px;
  }

  .pack__name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--fs-xl);
    line-height: 1.15;
  }

  .pack__sub {
    font-size: var(--fs-sm);
    color: var(--text-muted);
    margin-top: 2px;
  }

  .pack__pricing {
    display: flex;
    align-items: baseline;
    gap: 10px;
    flex-wrap: wrap;
    margin-bottom: 22px;
  }

  .pack__price {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 38px;
    letter-spacing: -1.4px;
    font-variant-numeric: tabular-nums;
  }

  .pack__usd {
    font-size: var(--fs-md);
    color: var(--text-muted);
    white-space: nowrap;
    flex: none;
  }

  .pack__checks {
    gap: 11px;
    margin-bottom: 28px;
    flex: 1;
  }

  .pack__check {
    font-size: var(--fs-md);
    gap: 11px;
  }

  .pack__cta {
    justify-content: center;
    padding: 14px 22px;
    border-radius: var(--r-md);
    font-size: var(--fs-md);
  }

  .packs__rubros {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
    margin-top: 26px;
    font-size: var(--fs-sm);
    color: var(--text-faint);
  }

  .packs__rubros-label {
    color: var(--text-muted);
    font-weight: 600;
  }

  .chip--sm {
    padding: 6px 14px;
    border-color: var(--border);
  }

  @media (max-width: 860px) {
    .packs__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
