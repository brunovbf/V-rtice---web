---
import Chevron from '../icons/Chevron.astro';
import Check from '../icons/Check.astro';
import Arrow from '../icons/Arrow.astro';
import BrowserMock from '../BrowserMock.astro';
import { wa } from '../../config/site';
import { trust } from '../../data/landing';
import { demoMain } from '../../data/demos';
---

<section id="hero" class="hero container">
  <div class="hero__glow" id="heroGlow" aria-hidden="true"></div>

  <div class="hero__copy">
    <p class="hero__badge">
      <span class="hero__pulse"></span>
      Precio de lanzamiento · cupos limitados
    </p>

    <h1 class="t-h1 hero__title">
      Que tu negocio se vea profesional <span class="grad">y funcione mejor</span>
    </h1>

    <p class="t-lead hero__lead">
      Sitios web profesionales y planillas de gestión a medida para comercios y profesionales de
      Uruguay. Prolijo, rápido y sin vueltas técnicas.
    </p>

    <div class="hero__actions">
      <a class="btn btn--violet btn--wide" href={wa('Hola Bruno, me interesa conocer los servicios de Vértice')}>
        Consultar por WhatsApp
        <Arrow size={17} color="#fff" />
      </a>
      <a class="btn btn--outline" href="#casos">Ver ejemplos</a>
    </div>

    <ul class="hero__trust">
      {
        trust.map((t) => (
          <li>
            <span class="check__box">
              <Chevron size={13} color="#5BE3A7" width={6} />
            </span>
            {t}
          </li>
        ))
      }
    </ul>
  </div>

  <div class="hero__visual">
    <div class="hero__visual-glow" aria-hidden="true"></div>
    <BrowserMock
      src={demoMain.src}
      alt={demoMain.alt}
      url={demoMain.url}
      dot={11}
      rotate
      widths={[420, 640, 900, 1180]}
      sizes="(max-width: 1024px) 100vw, 540px"
      eager
    />

    <div class="hero__float">
      <span class="hero__float-icon">
        <Check size={19} color="#5BE3A7" />
      </span>
      <div class="hero__float-text">
        <strong>Lista en 7 días</strong>
        <span>y online para vender</span>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    gap: 56px;
    align-items: center;
    padding-top: 60px;
    padding-bottom: 40px;
  }

  /*
   * Movimiento independiente: recorre el hero solo, con heroDrift 16s.
   * NO sigue al mouse. El README describe un seguimiento del cursor, pero en
   * el prototipo ese codigo (setupHeroGlow) nunca se invoca, asi que el
   * comportamiento real del diseno —y el de las capturas— es la deriva sola.
   */
  .hero__glow {
    position: absolute;
    top: 0;
    left: 0;
    width: 460px;
    height: 460px;
    margin: -230px 0 0 -230px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(124, 92, 255, 0.3), transparent 62%);
    filter: blur(30px);
    pointer-events: none;
    will-change: transform;
    animation: heroDrift 16s ease-in-out infinite;
    z-index: 0;
  }

  .hero__copy,
  .hero__visual {
    position: relative;
    z-index: 1;
  }

  .hero__badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: var(--violet-wash);
    border: 1px solid var(--border-violet);
    color: var(--lavender);
    padding: 7px 15px;
    border-radius: var(--r-pill);
    font-size: var(--fs-sm);
    font-weight: 600;
    margin-bottom: 26px;
  }

  .hero__pulse {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--green);
    box-shadow: 0 0 0 3px rgba(91, 227, 167, 0.2);
    flex: none;
  }

  .hero__title {
    margin-bottom: 22px;
  }

  .hero__lead {
    margin-bottom: 34px;
    max-width: 490px;
  }

  .hero__actions {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
    margin-bottom: 34px;
  }

  .hero__trust {
    display: flex;
    gap: 14px 26px;
    flex-wrap: wrap;
    font-size: var(--fs-md);
    color: var(--text-soft);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .hero__trust li {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .hero__visual-glow {
    position: absolute;
    inset: -50px -40px;
    background: radial-gradient(circle at 70% 30%, rgba(124, 92, 255, 0.4), transparent 62%);
    filter: blur(30px);
    pointer-events: none;
  }

  /* Capa de profundidad sobre el mockup. */
  .hero__float {
    position: absolute;
    bottom: -22px;
    left: -26px;
    background: var(--bg);
    border: 1px solid var(--border-violet);
    border-radius: var(--r-inner);
    padding: 14px 18px;
    display: flex;
    align-items: center;
    gap: 12px;
    box-shadow: var(--sh-float);
    transform: rotate(-2deg);
  }

  .hero__float-icon {
    width: 38px;
    height: 38px;
    border-radius: var(--r-md);
    background: var(--green-wash);
    display: flex;
    align-items: center;
    justify-content: center;
    flex: none;
  }

  .hero__float-text {
    line-height: 1.25;
  }

  .hero__float-text strong {
    display: block;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--fs-md);
  }

  .hero__float-text span {
    font-size: var(--fs-xs);
    color: var(--text-muted);
  }

  @media (max-width: 1024px) {
    .hero {
      grid-template-columns: 1fr;
      gap: 44px;
    }

    /* El mockup ya no tiene lugar para la tarjeta colgando: pasa a flujo. */
    .hero__float {
      position: static;
      transform: none;
      margin-top: 18px;
      width: fit-content;
    }
  }
</style>
