---
/**
 * Bloque "Ejemplo real: BB Studio". Solo capturas de la planilla: sin explicar
 * como funciona y sin datos del cliente a la vista. La imagen prueba que
 * existe; el detalle se muestra en la videollamada, que es a donde lleva el
 * boton de abajo.
 *
 * Las miniaturas abren un visor (PacksVisor.astro). No es un adorno: una
 * captura de Excel a 142px de ancho —tres en fila en un celular de 380px— no
 * se lee, y un bloque de capturas ilegibles no prueba nada. En el visor se
 * recorren con las flechas, el teclado o el dedo.
 *
 * El orden es explicito en los tres lugares: el numero de la miniatura, la
 * izquierda-derecha de la fila y el contador "1 / 3" del visor.
 *
 * Mientras no existan los archivos, en produccion el bloque no se renderiza.
 * Ver `mostrarEjemploBBStudio` en src/data/servicios.ts.
 */
import Arrow from '../icons/Arrow.astro';
import { wa } from '../../config/site';
import { capturasBBStudio, mostrarEjemploBBStudio } from '../../data/servicios';

/* Con capturas de verdad: miniaturas que abren el visor. */
const conCapturas = mostrarEjemploBBStudio;
/* Sin capturas: recuadros numerados, solo en dev, para acomodar el layout. */
const visible = conCapturas || import.meta.env.DEV;
---

{
  visible && (
    <div class="reveal ej">
      <p class="ej__title">Ejemplo real: BB Studio</p>

      <ul class="ej__strip">
        {capturasBBStudio.map((c, i) => (
          <li class="ej__item">
            {conCapturas ? (
              <button
                class="ej__thumb"
                type="button"
                data-ej-open={String(i)}
                aria-label={`Ampliar la captura ${i + 1} de ${capturasBBStudio.length}`}
              >
                <img src={c.src} alt={c.alt} loading="lazy" decoding="async" />
                <span class="ej__num" aria-hidden="true">
                  {i + 1}
                </span>
                <span class="ej__zoom" aria-hidden="true">
                  <svg
                    width="15"
                    height="15"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.4"
                    stroke-linecap="round"
                  >
                    <circle cx="10.5" cy="10.5" r="6.5" />
                    <line x1="15.5" y1="15.5" x2="21" y2="21" />
                  </svg>
                </span>
              </button>
            ) : (
              /*
               * TODO (Bruno): esto desaparece solo cuando existan las capturas.
               *   1. Crear la carpeta `public/img/packs/` y guardar ahi:
               *        bbstudio-1.webp · bbstudio-2.webp · bbstudio-3.webp
               *   2. Poner `mostrarEjemploBBStudio` en `true`
               *      (src/data/servicios.ts).
               * Este recuadro solo se ve en `npm run dev`, nunca en el sitio
               * publicado.
               */
              <div class="ej__thumb ej__thumb--todo">
                <span class="ej__num" aria-hidden="true">
                  {i + 1}
                </span>
                <span class="ej__todo">
                  Falta la captura
                  <code>{c.src}</code>
                </span>
              </div>
            )}
          </li>
        ))}
      </ul>

      <p class="ej__cta-text">
        ¿Querés verla funcionando? Te la mostramos por videollamada antes de contratar.
      </p>
      <a
        class="btn btn--green ej__cta"
        href={wa('Hola Bruno, quiero ver la planilla funcionando por videollamada')}
      >
        Quiero verla funcionando
        <Arrow size={16} color="#0D0B1A" />
      </a>
    </div>
  )
}

<style>
  .ej {
    margin-top: 48px;
    padding: 32px 30px;
    border-radius: var(--r-block);
    border: 1px solid var(--border-violet);
    background: var(--surface-raised);
  }

  .ej__title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--fs-lg);
    margin-bottom: 18px;
  }

  /*
   * `grid-auto-flow: column` reparte en partes iguales sin declarar cuantas
   * son: sirve para 2, 3 o 4 capturas sin tocar el CSS.
   */
  .ej__strip {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(0, 1fr);
    gap: 14px;
    list-style: none;
    margin: 0 0 24px;
    padding: 0;
  }

  .ej__thumb {
    position: relative;
    display: block;
    width: 100%;
    padding: 0;
    border: 1px solid var(--border);
    border-radius: var(--r-inner);
    overflow: hidden;
    background: var(--surface);
    cursor: zoom-in;
    transition:
      transform var(--t),
      border-color var(--t),
      box-shadow var(--t);
  }

  .ej__thumb:hover {
    transform: translateY(-3px);
    border-color: var(--border-violet-mid);
    box-shadow: var(--sh-card);
  }

  /*
   * `top left` y no `center`: una planilla arranca arriba a la izquierda, que
   * es donde estan los encabezados. Centrado, el recorte de la miniatura corta
   * justo la fila que le dice al visitante que esto es un Excel.
   */
  .ej__thumb img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    object-position: top left;
  }

  .ej__num {
    position: absolute;
    top: 10px;
    left: 10px;
    min-width: 24px;
    height: 24px;
    padding: 0 7px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--r-pill);
    background: rgba(13, 11, 26, 0.8);
    border: 1px solid var(--border-violet);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--fs-2xs);
    color: var(--lavender);
  }

  /*
   * La lupa queda siempre visible, no en hover: en celular no hay hover y es
   * justo donde mas hace falta avisar que la captura se puede agrandar.
   */
  .ej__zoom {
    position: absolute;
    bottom: 10px;
    right: 10px;
    width: 28px;
    height: 28px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--r-sm);
    background: rgba(13, 11, 26, 0.8);
    border: 1px solid var(--border-strong);
    color: var(--lavender);
  }

  /* ---------- Recuadro de dev, sin capturas ---------- */

  .ej__thumb--todo {
    display: flex;
    align-items: center;
    justify-content: center;
    aspect-ratio: 3 / 2;
    cursor: default;
    border-style: dashed;
    border-color: var(--border-strong);
  }

  .ej__thumb--todo:hover {
    transform: none;
    border-color: var(--border-strong);
    box-shadow: none;
  }

  .ej__todo {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 0 14px;
    text-align: center;
    font-size: var(--fs-xs);
    color: var(--text-faint);
  }

  .ej__todo code {
    font-size: var(--fs-2xs);
    color: var(--text-min);
    word-break: break-all;
  }

  /* ---------- Cierre del bloque ---------- */

  .ej__cta-text {
    font-size: var(--fs-md);
    color: var(--text-dim);
    margin-bottom: 18px;
    max-width: 460px;
    text-wrap: pretty;
  }

  /*
   * La fila pasa a deslizable en el mismo breakpoint en que los packs se
   * apilan a una columna (860px, ver tokens.css). Tres capturas en grilla dan
   * 142px cada una a 380px y 144px a 572px: en los dos casos no se distingue
   * nada, y el bloque existe justo para que se distinga. Al 76% se lee que es
   * una planilla, la siguiente asoma al costado —que es lo que avisa que hay
   * mas— y el bloque no se estira a tres pantallas de alto.
   */
  @media (max-width: 860px) {
    .ej__strip {
      grid-auto-columns: 76%;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      padding-bottom: 8px;
      overscroll-behavior-x: contain;
    }

    .ej__item {
      scroll-snap-align: start;
    }
  }

  @media (max-width: 560px) {
    .ej {
      padding: 26px 22px;
    }

    .ej__cta {
      width: 100%;
      justify-content: center;
    }
  }
</style>
