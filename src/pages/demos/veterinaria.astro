<script>
  import { initReveal } from '../../scripts/reveal';
  import { initWaForm } from '../../scripts/waForm';

  initReveal('.rv');
  initWaForm();

  // Selector de tipo de mascota: guarda el valor en el input oculto del form.
  const hidden = document.getElementById('tipoValue') as HTMLInputElement | null;
  document.querySelectorAll<HTMLButtonElement>('.tipo__btn').forEach((btn) => {
    btn.setAttribute('aria-pressed', 'false');
    btn.addEventListener('click', () => {
      document
        .querySelectorAll('.tipo__btn')
        .forEach((b) => b.setAttribute('aria-pressed', 'false'));
      btn.setAttribute('aria-pressed', 'true');
      if (hidden) hidden.value = btn.dataset.tipo ?? '';
    });
  });
</script>
