---
/**
 * Demo Patitas — veterinaria. Personalidad calida y redondeada.
 * Paleta, tipografia y radios propios: no comparte nada con la landing salvo
 * el patron de reveal y el sello del pie.
 * Breakpoints propios de esta demo: 1024 / 720 / 520.
 */
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import VerticeSeal from '../../components/VerticeSeal.astro';
import WhatsApp from '../../components/icons/WhatsApp.astro';
import Arrow from '../../components/icons/Arrow.astro';
import Check from '../../components/icons/Check.astro';
import { WHATSAPP_NUMBER, wa } from '../../config/site';
import {
  heroChips,
  tipos,
  servicios,
  stats,
  motivos,
  info,
  testimonios,
} from '../../data/demos/veterinaria';
import vetHero from '../../assets/vet-hero.jpg';

const fonts =
  'https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800&family=Karla:wght@400;500;600;700&display=swap';

const waTurno = wa('Hola, quiero reservar un turno para mi mascota en Patitas');
const waGeneral = wa('Hola Patitas, quiero hacer una consulta');
---

<BaseLayout
  title="Patitas — Clínica veterinaria en Melo | Demo de Vértice"
  description="Demo de sitio para clínica veterinaria: turnos online, vacunación, cirugía y urgencias 24 horas. Ejemplo de diseño a medida hecho por Vértice."
  fonts={fonts}
  themeColor="#FDF8F3"
  noindex
>
  <div class="vet">
    <!-- NAV -->
    <header class="pad nav">
      <div class="brand">
        <span class="brand__logo">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="#FFF6EF" aria-hidden="true">
            <ellipse cx="12" cy="16" rx="4.6" ry="3.9"></ellipse>
            <ellipse cx="5.6" cy="11" rx="2.2" ry="2.7"></ellipse>
            <ellipse cx="18.4" cy="11" rx="2.2" ry="2.7"></ellipse>
            <ellipse cx="9" cy="6.6" rx="2.1" ry="2.6"></ellipse>
            <ellipse cx="15" cy="6.6" rx="2.1" ry="2.6"></ellipse>
          </svg>
        </span>
        <span class="brand__name">Patitas</span>
      </div>
      <nav class="nav__links" aria-label="Navegación principal">
        <a href="#servicios">Servicios</a>
        <a href="#nosotros">Nosotros</a>
        <a href="#turnos">Turnos</a>
        <a href="#contacto">Contacto</a>
        <a class="nav__cta" href="#turnos">Reservar turno</a>
      </nav>
    </header>

    <!-- HERO -->
    <section class="hero-wrap">
      <div class="hero-blob hero-blob--1" aria-hidden="true"></div>
      <div class="hero-blob hero-blob--2" aria-hidden="true"></div>

      <div class="pad hero">
        <div>
          <p class="hero__badge">
            <span class="hero__dot"></span>
            Atención con amor desde 2009
          </p>
          <h1 class="t-h1">
            Cuidamos a tu mascota <span class="accent">como de la familia</span>
          </h1>
          <p class="hero__lead">
            Turnos online, vacunación, cirugía y urgencias 24 horas. Profesionales que tratan a tu
            compañero con el cariño que merece.
          </p>
          <div class="hero__actions">
            <a class="btn btn--primary btn-w" href="#turnos">
              Reservar turno online
              <Arrow size={17} />
            </a>
            <a class="btn btn--ghost btn-w" href="#servicios">Ver servicios</a>
          </div>
          <ul class="hero__chips">
            {
              heroChips.map((c) => (
                <li>
                  <span class="hero__chip-icon">
                    <Check size={12} color="#2F7F72" width={3.2} />
                  </span>
                  {c}
                </li>
              ))
            }
          </ul>
        </div>

        <div class="hero__media">
          <div class="hero__photo">
            <Image
              src={vetHero}
              alt="Perro atendido en la clínica veterinaria Patitas"
              widths={[420, 640, 900]}
              sizes="(max-width: 1024px) 100vw, 520px"
              class="hero__img"
            />
          </div>
          <div class="hero__pill">
            <div class="hero__avatars">
              <span style="background:#F3D9C6"></span>
              <span style="background:#D9E7E2"></span>
              <span style="background:#F6E3B8"></span>
            </div>
            <div class="hero__pill-text">
              <strong>+1.200 mascotas</strong>
              <span>felices nos eligen</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- SERVICIOS -->
    <section id="servicios" class="surface">
      <div class="pad block">
        <div class="rv head">
          <p class="kicker">Lo que hacemos</p>
          <h2 class="t-h2">Todo para el bienestar de tu mascota</h2>
          <p class="head__lead">Un equipo completo para cada etapa de su vida.</p>
        </div>
        <div class="g-serv">
          {
            servicios.map((s) => (
              <article class="rv scard card-pad">
                <div class="scard__icon" style={`background:${s.bg}`}>
                  <span style={`color:${s.fg}`}>{s.n}</span>
                </div>
                <h3 class="scard__title">{s.title}</h3>
                <p class="scard__desc">{s.desc}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <!-- STATS -->
    <section id="nosotros" class="dark">
      <div class="pad stats-block">
        <div class="rv g-stats">
          {
            stats.map((st) => (
              <div class="stat">
                <div class="stat__n">{st.n}</div>
                <div class="stat__label">{st.label}</div>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- TURNOS -->
    <section id="turnos" class="turnos-wrap">
      <div class="turnos-blob" aria-hidden="true"></div>
      <div class="pad block">
        <div class="rv head">
          <p class="kicker">Reservá en 1 minuto</p>
          <h2 class="t-h2">Pedí tu turno online</h2>
          <p class="head__lead">Completá el formulario y te confirmamos por WhatsApp.</p>
        </div>

        <div class="rv g-turnos">
          <div class="formcard card-pad">
            <p class="formcard__title">Datos del turno</p>

            <form
              class="form"
              data-wa-form
              data-wa-number={WHATSAPP_NUMBER}
              data-wa-intro="Hola Patitas, quiero reservar un turno."
            >
              <div class="g-inputs">
                <label>
                  Tu nombre *
                  <input
                    type="text"
                    name="nombre"
                    placeholder="Ej. Laura Pérez"
                    data-wa-label="Nombre"
                    required
                  />
                </label>
                <label>
                  Teléfono *
                  <input
                    type="tel"
                    name="telefono"
                    placeholder="099 123 456"
                    data-wa-label="Teléfono"
                    required
                  />
                </label>
              </div>

              <div class="g-inputs">
                <label>
                  Nombre de la mascota
                  <input
                    type="text"
                    name="mascota"
                    placeholder="Ej. Toby"
                    data-wa-label="Mascota"
                  />
                </label>
                <div class="tipo">
                  <span class="tipo__label">Tipo</span>
                  <div class="tipo__group" role="group" aria-label="Tipo de mascota">
                    {
                      tipos.map((tp) => (
                        <button type="button" class="tipo__btn" data-tipo={tp}>
                          {tp}
                        </button>
                      ))
                    }
                  </div>
                  <input type="hidden" name="tipo" data-wa-label="Tipo" id="tipoValue" />
                </div>
              </div>

              <label>
                Motivo de la consulta
                <select name="motivo" data-wa-label="Motivo">
                  {motivos.map((m) => <option value={m}>{m}</option>)}
                </select>
              </label>

              <label>
                Fecha preferida
                <input type="date" name="fecha" data-wa-label="Fecha" />
              </label>

              <button type="submit" class="btn btn--primary form__submit">
                Solicitar turno
                <Arrow size={17} />
              </button>
            </form>

            <div class="form__sent" data-wa-sent hidden role="status">
              <Check size={18} color="#2F7F72" />
              ¡Solicitud enviada! Te confirmamos el turno por WhatsApp.
            </div>
          </div>

          <div id="contacto" class="info">
            {
              info.map((f) => (
                <div class="info__card">
                  <p class="info__label">{f.label}</p>
                  <p class="info__value">{f.value}</p>
                </div>
              ))
            }
            <a class="btn btn--teal" href={waGeneral}>
              <WhatsApp size={20} color="currentColor" />
              Escribir por WhatsApp
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- TESTIMONIOS -->
    <section class="surface">
      <div class="pad block">
        <div class="rv head">
          <p class="kicker">Familias conformes</p>
          <h2 class="t-h2">Lo que dicen nuestros clientes</h2>
        </div>
        <div class="g-test">
          {
            testimonios.map((q) => (
              <figure class="rv tcard card-pad">
                <div class="tcard__stars">
                  {Array.from({ length: 5 }).map(() => (
                    <svg width="17" height="17" viewBox="0 0 24 24" fill="#E8A63F" aria-hidden="true">
                      <polygon points="12 2 15 9 22 9.3 16.5 14 18.5 21 12 17 5.5 21 7.5 14 2 9.3 9 9" />
                    </svg>
                  ))}
                </div>
                <blockquote class="tcard__text">“{q.text}”</blockquote>
                <figcaption class="tcard__author">
                  <span class="tcard__avatar" style={`background:${q.bg}`}>
                    {q.ini}
                  </span>
                  <span>
                    <span class="tcard__name">{q.name}</span>
                    <span class="tcard__role">{q.role}</span>
                  </span>
                </figcaption>
              </figure>
            ))
          }
        </div>
      </div>
    </section>

    <!-- CTA FINAL -->
    <div class="pad cta-wrap">
      <div class="rv cta card-pad">
        <div class="cta__blob cta__blob--1" aria-hidden="true"></div>
        <div class="cta__blob cta__blob--2" aria-hidden="true"></div>
        <div class="cta__inner">
          <h2 class="t-h2 cta__title">¿Tu mascota necesita atención?</h2>
          <p class="cta__lead">Reservá tu turno hoy o escribinos. Te respondemos al toque.</p>
          <a class="btn btn--light btn-w" href={waTurno}>
            <WhatsApp size={20} color="currentColor" />
            Reservar por WhatsApp
          </a>
        </div>
      </div>
    </div>

    <!-- FOOTER -->
    <footer class="dark">
      <div class="pad g-foot">
        <div>
          <div class="brand foot__brand">
            <span class="brand__logo brand__logo--sm">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="#FFF6EF" aria-hidden="true">
                <ellipse cx="12" cy="16" rx="4.6" ry="3.9"></ellipse>
                <ellipse cx="5.6" cy="11" rx="2.2" ry="2.7"></ellipse>
                <ellipse cx="18.4" cy="11" rx="2.2" ry="2.7"></ellipse>
                <ellipse cx="9" cy="6.6" rx="2.1" ry="2.6"></ellipse>
                <ellipse cx="15" cy="6.6" rx="2.1" ry="2.6"></ellipse>
              </svg>
            </span>
            <span class="brand__name brand__name--foot">Patitas</span>
          </div>
          <p class="foot__desc">
            Clínica veterinaria en Melo, Cerro Largo. Cuidamos a tu mascota como de la familia desde
            2009.
          </p>
        </div>
        <div class="foot__col">
          <span class="foot__col-title">Servicios</span>
          <a href="#servicios">Consultas</a>
          <a href="#servicios">Vacunación</a>
          <a href="#servicios">Cirugía</a>
          <a href="#servicios">Urgencias 24 hs</a>
        </div>
        <div class="foot__col">
          <span class="foot__col-title">Contacto</span>
          <a href={waGeneral}>099 492 918</a>
          <a href="#turnos">Reservar turno</a>
          <span>Av. Siempre Viva 1234</span>
        </div>
      </div>
      <div class="pad foot__legal">
        <span>© 2026 Patitas — Clínica Veterinaria · Melo, Uruguay</span>
        <VerticeSeal color="#E8814F" textColor="rgba(253,248,243,.55)" />
      </div>
    </footer>
  </div>
</BaseLayout>

<style>
  /* ---------- Tokens propios de Patitas ---------- */
  .vet {
    --cream: #fdf8f3;
    --white: #fff;
    --ink: #2a211c;
    --ink-soft: #3d322b;
    --muted: #6b5b51;
    --faint: #8a7a6f;
    --terra: #d9663f;
    --terra-light: #e8814f;
    --terra-dark: #c4562f;
    --teal: #2f7f72;
    --teal-dark: #245f55;
    --gold: #e8a63f;

    background: var(--cream);
    color: var(--ink);
    font-family: Karla, sans-serif;
    overflow-x: clip;
  }

  .vet :global(a:hover) {
    color: var(--terra-dark);
  }

  .pad {
    max-width: 1200px;
    margin: 0 auto;
    padding-left: 32px;
    padding-right: 32px;
  }

  .block {
    padding-top: 88px;
    padding-bottom: 88px;
  }

  .surface {
    background: var(--white);
  }

  .dark {
    background: var(--ink);
    color: var(--cream);
  }

  /* ---------- Tipografia ---------- */
  .t-h1 {
    font-family: Outfit, sans-serif;
    font-weight: 800;
    font-size: 60px;
    line-height: 1.06;
    letter-spacing: -1.8px;
    margin-bottom: 20px;
    text-wrap: balance;
  }

  .t-h2 {
    font-family: Outfit, sans-serif;
    font-weight: 800;
    font-size: 42px;
    line-height: 1.08;
    letter-spacing: -1.2px;
    text-wrap: balance;
  }

  .accent {
    color: var(--terra);
  }

  .kicker {
    font-family: Outfit, sans-serif;
    font-weight: 600;
    font-size: 13.5px;
    letter-spacing: 1.6px;
    text-transform: uppercase;
    color: var(--terra);
    margin-bottom: 14px;
  }

  .head {
    max-width: 600px;
    margin-bottom: 52px;
  }

  .head .t-h2 {
    margin-bottom: 14px;
  }

  .head__lead {
    font-size: 17.5px;
    line-height: 1.6;
    color: var(--muted);
  }

  /* ---------- Botones (todos pastilla) ---------- */
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    border-radius: 100px;
    font-family: Outfit, sans-serif;
    font-weight: 700;
    transition:
      transform 0.18s ease,
      box-shadow 0.18s ease,
      border-color 0.18s ease,
      background 0.18s ease;
  }

  .btn--primary {
    background: var(--terra);
    color: #fff6ef;
    padding: 17px 32px;
    font-size: 16.5px;
    border: none;
    cursor: pointer;
    box-shadow: 0 14px 30px -10px rgba(217, 102, 63, 0.65);
  }

  .btn--primary:hover {
    color: #fff6ef;
    transform: translateY(-2px);
    box-shadow: 0 20px 40px -10px rgba(217, 102, 63, 0.8);
  }

  .btn--ghost {
    padding: 17px 30px;
    border: 1.5px solid rgba(42, 33, 28, 0.15);
    font-weight: 600;
    font-size: 16px;
    color: var(--ink);
  }

  .btn--ghost:hover {
    color: var(--ink);
    border-color: var(--terra);
    background: rgba(217, 102, 63, 0.06);
  }

  .btn--teal {
    justify-content: center;
    background: var(--teal);
    color: var(--cream);
    padding: 17px 26px;
    font-size: 16px;
    box-shadow: 0 14px 30px -12px rgba(47, 127, 114, 0.6);
  }

  .btn--teal:hover {
    color: var(--cream);
    transform: translateY(-2px);
    box-shadow: 0 20px 40px -12px rgba(47, 127, 114, 0.75);
  }

  .btn--light {
    background: #fff6ef;
    color: var(--terra-dark);
    padding: 18px 34px;
    font-size: 17px;
    gap: 11px;
    box-shadow: 0 16px 34px -12px rgba(42, 33, 28, 0.4);
  }

  .btn--light:hover {
    color: var(--terra-dark);
    transform: translateY(-2px);
    box-shadow: 0 22px 44px -12px rgba(42, 33, 28, 0.5);
  }

  /* ---------- Nav ---------- */
  .nav {
    position: relative;
    z-index: 3;
    padding-top: 24px;
    padding-bottom: 24px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .brand__logo {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: linear-gradient(140deg, var(--terra-light), var(--terra));
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 8px 20px -8px rgba(217, 102, 63, 0.6);
    flex: none;
  }

  .brand__logo--sm {
    width: 40px;
    height: 40px;
    box-shadow: none;
  }

  .brand__name {
    font-family: Outfit, sans-serif;
    font-weight: 700;
    font-size: 24px;
    letter-spacing: -0.4px;
  }

  .brand__name--foot {
    font-size: 22px;
    letter-spacing: 0;
  }

  .nav__links {
    display: flex;
    align-items: center;
    gap: 28px;
    font-size: 15.5px;
    font-weight: 500;
    color: var(--muted);
  }

  .nav__cta {
    background: var(--terra);
    color: #fff6ef;
    padding: 12px 22px;
    border-radius: 100px;
    font-family: Outfit, sans-serif;
    font-weight: 600;
    box-shadow: 0 8px 20px -8px rgba(217, 102, 63, 0.6);
    transition:
      transform 0.18s ease,
      box-shadow 0.18s ease;
  }

  .nav__cta:hover {
    color: #fff6ef;
    transform: translateY(-2px);
    box-shadow: 0 12px 26px -8px rgba(217, 102, 63, 0.75);
  }

  /* ---------- Hero ---------- */
  .hero-wrap {
    position: relative;
    overflow: hidden;
  }

  .hero-blob {
    position: absolute;
    border-radius: 50%;
    pointer-events: none;
  }

  .hero-blob--1 {
    top: -180px;
    right: -120px;
    width: 620px;
    height: 620px;
    background: radial-gradient(circle, rgba(232, 129, 79, 0.18), transparent 66%);
  }

  .hero-blob--2 {
    bottom: -160px;
    left: -140px;
    width: 520px;
    height: 520px;
    background: radial-gradient(circle, rgba(47, 127, 114, 0.13), transparent 68%);
  }

  .hero {
    position: relative;
    padding-top: 56px;
    padding-bottom: 84px;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 60px;
    align-items: center;
  }

  .hero__badge {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    background: var(--white);
    border: 1px solid rgba(42, 33, 28, 0.09);
    padding: 8px 16px;
    border-radius: 100px;
    font-size: 13.5px;
    font-weight: 600;
    color: var(--muted);
    margin-bottom: 26px;
    box-shadow: 0 4px 14px -6px rgba(42, 33, 28, 0.14);
  }

  .hero__dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--teal);
  }

  .hero__lead {
    font-size: 18.5px;
    line-height: 1.65;
    color: var(--muted);
    margin-bottom: 34px;
    max-width: 470px;
    text-wrap: pretty;
  }

  .hero__actions {
    display: flex;
    gap: 13px;
    flex-wrap: wrap;
    margin-bottom: 36px;
  }

  .hero__chips {
    display: flex;
    gap: 12px 24px;
    flex-wrap: wrap;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .hero__chips li {
    display: flex;
    align-items: center;
    gap: 9px;
    font-size: 14.5px;
    font-weight: 500;
    color: var(--muted);
  }

  .hero__chip-icon {
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: rgba(47, 127, 114, 0.13);
    display: flex;
    align-items: center;
    justify-content: center;
    flex: none;
  }

  .hero__media {
    position: relative;
  }

  .hero__photo {
    position: relative;
    border-radius: 32px;
    overflow: hidden;
    box-shadow: 0 40px 80px -30px rgba(42, 33, 28, 0.35);
  }

  .hero__photo :global(.hero__img) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4/5;
    object-fit: cover;
  }

  .hero__pill {
    position: absolute;
    bottom: 26px;
    left: -24px;
    background: var(--white);
    border-radius: 20px;
    padding: 16px 22px;
    display: flex;
    align-items: center;
    gap: 14px;
    box-shadow: 0 20px 44px -16px rgba(42, 33, 28, 0.3);
  }

  .hero__avatars {
    display: flex;
  }

  .hero__avatars span {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    border: 2.5px solid var(--white);
  }

  .hero__avatars span + span {
    margin-left: -11px;
  }

  .hero__pill-text {
    line-height: 1.3;
  }

  .hero__pill-text strong {
    display: block;
    font-family: Outfit, sans-serif;
    font-weight: 700;
    font-size: 17px;
    font-variant-numeric: tabular-nums;
  }

  .hero__pill-text span {
    font-size: 13px;
    color: var(--faint);
  }

  /* ---------- Servicios ---------- */
  .g-serv {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 22px;
  }

  .scard {
    background: var(--cream);
    border: 1px solid rgba(42, 33, 28, 0.07);
    border-radius: 24px;
    padding: 32px 30px;
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease,
      border-color 0.2s ease;
  }

  .scard:hover {
    transform: translateY(-5px);
    box-shadow: 0 24px 48px -24px rgba(42, 33, 28, 0.28);
    border-color: rgba(217, 102, 63, 0.3);
  }

  .scard__icon {
    width: 54px;
    height: 54px;
    border-radius: 18px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 22px;
  }

  .scard__icon span {
