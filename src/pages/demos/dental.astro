---
/**
 * Demo Bianchi — odontologia. Personalidad editorial y liviana.
 * Serif de display liviana (Newsreader) + sans para cuerpo (Work Sans), cero
 * esquinas redondeadas, hilos de 1px como recurso de composicion.
 * Breakpoints propios: 1024 / 720 / 520.
 */
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import VerticeSeal from '../../components/VerticeSeal.astro';
import WhatsApp from '../../components/icons/WhatsApp.astro';
import Arrow from '../../components/icons/Arrow.astro';
import Check from '../../components/icons/Check.astro';
import { WHATSAPP_NUMBER, wa } from '../../config/site';
import {
  heroFacts,
  stats,
  motivos,
  tratamientos,
  pasos,
  precios,
  financiacion,
  equipo,
  faqs,
} from '../../data/demos/dental';
import fotoHero from '../../assets/dental-consultorio.jpg';
import fotoSala from '../../assets/dental-sala.jpg';

const fonts =
  'https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,300;0,6..72,400;0,6..72,500;0,6..72,600;1,6..72,300;1,6..72,400&family=Work+Sans:wght@400;500;600&display=swap';

const waLink = wa('Hola Bianchi, quiero consultar por un tratamiento');
---

<BaseLayout
  title="Bianchi Odontología — Consultorio dental en Melo | Demo de Vértice"
  description="Demo de sitio para consultorio odontológico: turnos online, precios transparentes y financiación en cuotas. Ejemplo de diseño a medida hecho por Vértice."
  fonts={fonts}
  themeColor="#F7F7F4"
  noindex
>
  <div class="dental">
    <!-- NAV -->
    <header class="navbar">
      <div class="pad nav">
        <a class="brand" href="#top">
          <span class="brand__name">Bianchi</span>
          <span class="brand__sub">Odontología</span>
        </a>
        <nav class="nav__links" aria-label="Navegación principal">
          <a href="#servicios">Tratamientos</a>
          <a href="#visita">Primera visita</a>
          <a href="#precios">Precios</a>
          <a href="#equipo">Equipo</a>
          <a href="#faq">Preguntas</a>
          <a class="nav__cta" href="#agenda">Agendar visita</a>
        </nav>
      </div>
    </header>

    <!-- HERO -->
    <section id="top" class="pad hero-block">
      <div class="g-hero">
        <div>
          <p class="overline">Consultorio dental · Melo</p>
          <h1 class="t-h1">
            Odontología moderna, <em>sin vueltas</em> y sin sorpresas
          </h1>
          <p class="hero__lead">
            Turnos online, precios claros antes de empezar y tecnología que hace que ir al dentista
            deje de ser un problema.
          </p>
          <div class="hero__facts">
            {
              heroFacts.map((f) => (
                <div class="fact">
                  <div class="fact__n">{f.n}</div>
                  <div class="fact__label">{f.label}</div>
                </div>
              ))
            }
          </div>
        </div>

        <!-- Formulario en portada -->
        <div id="agenda" class="agenda card-pad">
          <p class="agenda__title">Agendá tu visita</p>
          <p class="agenda__sub">Sin pago online. Confirmamos por WhatsApp en el día.</p>

          <form
            class="form"
            data-wa-form
            data-wa-number={WHATSAPP_NUMBER}
            data-wa-intro="Hola Bianchi, quiero agendar una visita."
          >
            <div class="g-inputs">
              <label>
                Tu nombre *
                <input
                  type="text"
                  name="nombre"
                  placeholder="Ej. Mariana López"
                  data-wa-label="Nombre"
                  required
                />
              </label>
              <label>
                Teléfono *
                <input
                  type="tel"
                  name="telefono"
                  placeholder="099 123 456"
                  data-wa-label="Teléfono"
                  required
                />
              </label>
            </div>
            <label>
              Motivo
              <select name="motivo" data-wa-label="Motivo">
                {motivos.map((m) => <option value={m}>{m}</option>)}
              </select>
            </label>
            <label>
              Fecha
              <input type="date" name="fecha" data-wa-label="Fecha" />
            </label>
            <button type="submit" class="btn btn--ink">
              Agendar
              <Arrow size={16} width={2.4} />
            </button>
          </form>

          <div class="form__sent" data-wa-sent hidden role="status">
            <Check size={17} color="#0F5C6B" width={2.8} />
            ¡Solicitud enviada! Te confirmamos el turno por WhatsApp.
          </div>
        </div>
      </div>

      <!-- Franja panoramica 24:9 -->
      <div class="rv hero__strip">
        <figure class="shot">
          <Image
            src={fotoHero}
            alt="Consultorio dental de Bianchi Odontología"
            widths={[720, 1200, 1800, 2200]}
            sizes="100vw"
            class="shot__img shot__img--pano"
          />
          <figcaption class="shot__credit">
            <a href="https://unsplash.com/@benyamin_bohlouli" target="_blank" rel="noopener nofollow">
              Photo by Benyamin Bohlouli on Unsplash
            </a>
          </figcaption>
        </figure>
      </div>
    </section>

    <!-- STATS -->
    <section class="stats">
      <div class="pad">
        <div class="rv g-stats">
          {
            stats.map((st) => (
              <div class="stat-cell">
                <div class="stat__n">{st.n}</div>
                <div class="stat__label">{st.label}</div>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- TRATAMIENTOS -->
    <section id="servicios" class="pad block">
      <div class="rv split">
        <div class="split__main">
          <p class="overline overline--accent">Tratamientos</p>
          <h2 class="t-h2">Todo lo que tu sonrisa necesita</h2>
        </div>
        <p class="split__aside">
          Desde el control de rutina hasta la rehabilitación completa.
        </p>
      </div>

      <div class="g-serv">
        {
          tratamientos.map((t) => (
            <article class="rv tcell card-pad">
              <div class="tcell__n">{t.n}</div>
              <h3 class="tcell__title">{t.title}</h3>
              <p class="tcell__desc">{t.desc}</p>
            </article>
          ))
        }
      </div>
    </section>

    <!-- PRIMERA VISITA -->
    <section id="visita" class="surface">
      <div class="pad block">
        <div class="rv g-visita">
          <div>
            <p class="overline overline--accent">Primera visita</p>
            <h2 class="t-h2 visita__title">Así de simple es empezar</h2>
            <div class="g-pasos">
              {
                pasos.map((p) => (
                  <div class="paso">
                    <div class="paso__n">Paso {p.n}</div>
                    <div>
                      <h3 class="paso__title">{p.title}</h3>
                      <p class="paso__desc">{p.desc}</p>
                    </div>
                  </div>
                ))
              }
            </div>
          </div>
          <div>
            <figure class="shot">
              <Image
                src={fotoSala}
                alt="Sala de atención del consultorio"
                widths={[420, 640, 900]}
                sizes="(max-width: 1024px) 100vw, 460px"
                class="shot__img shot__img--tall"
              />
              <figcaption class="shot__credit">
                <a href="https://unsplash.com/@karibjorn" target="_blank" rel="noopener nofollow">
                  Photo by Kari Bjorn Photography on Unsplash
                </a>
              </figcaption>
            </figure>
          </div>
        </div>
      </div>
    </section>

    <!-- PRECIOS -->
    <section id="precios" class="pad block">
      <div class="rv precios__head">
        <p class="overline overline--accent">Precios transparentes</p>
        <h2 class="t-h2">Sabés cuánto cuesta antes de sentarte en el sillón</h2>
      </div>

      <div class="rv g-precios">
        <div>
          {
            precios.map((pr) => (
              <div class="price-row">
                <span class="price-row__item">{pr.item}</span>
                <span class="price-row__price">{pr.price}</span>
              </div>
            ))
          }
          <p class="precios__note">
            Precios de referencia en pesos uruguayos. El presupuesto final se confirma en la
            consulta de diagnóstico.
          </p>
        </div>

        <div class="finan card-pad">
          <h3 class="finan__title">Financiación en cuotas</h3>
          <p class="finan__lead">
            Los tratamientos largos no tienen por qué pagarse de una vez.
          </p>
          <div class="finan__list">
            {
              financiacion.map((fi) => (
                <div class="finan__item">
                  <Check size={16} color="#7FC4CF" width={2.6} />
                  {fi}
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <!-- EQUIPO -->
    <section id="equipo" class="surface">
      <div class="pad block">
        <div class="rv equipo__head">
          <p class="overline overline--accent">Equipo</p>
          <h2 class="t-h2">Quiénes te atienden</h2>
        </div>
        <div class="g-equipo">
          {
            equipo.map((e) => (
              <article class="rv person">
                <div class="person__photo">
                  <span>{e.ini}</span>
                </div>
                <p class="overline overline--accent overline--sm">{e.role}</p>
                <h3 class="person__name">{e.name}</h3>
                <p class="person__desc">{e.desc}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section id="faq" class="pad block">
      <div class="rv faq__head">
        <p class="overline overline--accent">Preguntas frecuentes</p>
        <h2 class="t-h2">Lo que todos preguntan</h2>
      </div>
      <div class="rv faq">
        {
          faqs.map((q) => (
            <details class="faq__item" name="faq">
              <summary class="faq__q">
                {q.q}
                <span class="faq__icon" aria-hidden="true" />
              </summary>
              <div class="faq__a">
                <p>{q.a}</p>
              </div>
            </details>
          ))
        }
      </div>
    </section>

    <!-- CTA -->
    <section class="cta">
      <div class="pad cta__inner">
        <div class="cta__copy">
          <h2 class="t-h2 cta__title">Tu próxima sonrisa empieza con un turno</h2>
          <p class="cta__lead">
            Agendá online o escribinos por WhatsApp. Te respondemos en el día.
          </p>
        </div>
        <a class="btn btn--paper btn-w" href={waLink}>
          <WhatsApp size={19} color="currentColor" />
          Escribir por WhatsApp
        </a>
      </div>
    </section>

    <!-- FOOTER -->
    <footer class="pad foot">
      <div class="g-foot">
        <div>
          <p class="foot__name">Bianchi Odontología</p>
          <p class="foot__data">
            18 de Julio 845, Melo<br />Lun a Vie 9–19 hs · Sáb 9–13 hs
          </p>
        </div>
        <div class="foot__links">
          <a href={waLink}>099 492 918</a>
          <a href="#agenda">Agendar visita</a>
          <a href="#precios">Precios</a>
        </div>
        <VerticeSeal color="#0F5C6B" textColor="#6E7679" />
      </div>
      <p class="foot__legal">© 2026 Bianchi Odontología · Melo, Uruguay</p>
    </footer>
  </div>
</BaseLayout>

<style>
  /* ---------- Tokens propios de Bianchi ---------- */
  .dental {
    --paper: #f7f7f4;
    --white: #fff;
    --ink: #14181a;
    --muted: #4a5255;
    --faint: #6e7679;
    --petrol: #0f5c6b;
    --petrol-light: #7fc4cf;
    --rule: rgba(20, 24, 26, 0.1);
    --rule-strong: rgba(20, 24, 26, 0.12);

    background: var(--paper);
    color: var(--ink);
    font-family: 'Work Sans', sans-serif;
    overflow-x: clip;
  }

  .dental :global(a:hover) {
    color: var(--petrol);
  }

  .pad {
    max-width: 1200px;
    margin: 0 auto;
    padding-left: 32px;
    padding-right: 32px;
  }

  .block {
    padding-top: 88px;
    padding-bottom: 88px;
  }

  .surface {
    background: var(--white);
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
  }

  /* ---------- Tipografia editorial ---------- */
  .t-h1 {
    font-family: Newsreader, serif;
    font-weight: 400;
    font-size: 66px;
    line-height: 1.08;
    letter-spacing: -1.6px;
    margin-bottom: 26px;
    text-wrap: balance;
  }

  .t-h1 em {
    font-style: italic;
    color: var(--petrol);
  }

  .t-h2 {
    font-family: Newsreader, serif;
    font-weight: 400;
    font-size: 44px;
    line-height: 1.1;
    letter-spacing: -1.2px;
    text-wrap: balance;
  }

  .overline {
    font-size: 11.5px;
    letter-spacing: 2.4px;
    text-transform: uppercase;
    color: var(--faint);
    margin-bottom: 26px;
  }

  .overline--accent {
    color: var(--petrol);
    margin-bottom: 16px;
  }

  .overline--sm {
    letter-spacing: 1.6px;
    margin-bottom: 8px;
  }

  /* ---------- Botones (rectos) ---------- */
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    font-family: 'Work Sans', sans-serif;
    font-weight: 600;
    border: none;
    cursor: pointer;
    transition:
      background 0.18s ease,
      color 0.18s ease;
  }

  .btn--ink {
    background: var(--ink);
    color: var(--paper);
    padding: 16px;
    font-size: 15.5px;
    letter-spacing: 0.3px;
  }

  .btn--ink:hover {
    background: var(--petrol);
    color: var(--paper);
  }

  .btn--paper {
    background: var(--paper);
    color: var(--ink);
    padding: 18px 32px;
    font-size: 16px;
    gap: 11px;
  }

  .btn--paper:hover {
    background: var(--petrol-light);
    color: var(--ink);
  }

  /* ---------- Nav ---------- */
  .navbar {
    border-bottom: 1px solid var(--rule);
  }

  .nav {
    padding-top: 22px;
    padding-bottom: 22px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }

  .brand {
    display: flex;
    flex-direction: column;
    line-height: 1.05;
  }

  .brand__name {
    font-family: Newsreader, serif;
    font-weight: 500;
    font-size: 23px;
    letter-spacing: -0.3px;
  }

  .brand__sub {
    font-size: 10.5px;
    letter-spacing: 2.6px;
    text-transform: uppercase;
    color: var(--faint);
    margin-top: 3px;
  }

  .nav__links {
    display: flex;
    align-items: center;
    gap: 26px;
    font-size: 14.5px;
    color: var(--muted);
  }

  .nav__cta {
    border: 1px solid var(--ink);
    padding: 11px 20px;
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.2px;
    color: var(--ink);
    transition:
      background 0.18s ease,
      color 0.18s ease;
  }

  .nav__cta:hover {
    background: var(--ink);
    color: var(--paper);
  }

  /* ---------- Hero ---------- */
  .hero-block {
    padding-top: 76px;
    padding-bottom: 84px;
  }

  .g-hero {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    gap: 64px;
    align-items: start;
  }

  .hero__lead {
    font-size: 18.5px;
    line-height: 1.65;
    color: var(--muted);
    margin-bottom: 40px;
    max-width: 480px;
    text-wrap: pretty;
  }

  .hero__facts {
    display: flex;
    flex-wrap: wrap;
    border-top: 1px solid var(--rule-strong);
  }

  .fact {
    padding: 20px 28px 0 0;
    margin-right: 28px;
  }

  .fact__n {
    font-family: Newsreader, serif;
    font-weight: 500;
    font-size: 28px;
    line-height: 1;
    letter-spacing: -0.6px;
    font-variant-numeric: tabular-nums;
    margin-bottom: 6px;
  }

  .fact__label {
    font-size: 13.5px;
    color: var(--faint);
  }

  .hero__strip {
    margin-top: 56px;
  }

  /* ---------- Fotos con atribucion ---------- */
  .shot {
    position: relative;
    margin: 0;
  }

  .shot :global(.shot__img) {
    display: block;
    width: 100%;
    height: auto;
    object-fit: cover;
  }

  .shot :global(.shot__img--pano) {
    aspect-ratio: 24/9;
  }

  .shot :global(.shot__img--tall) {
    aspect-ratio: 4/5;
  }

  .shot__credit {
    position: absolute;
    bottom: 0;
    right: 0;
    font-size: 10px;
    line-height: 1;
    padding: 6px 9px;
    color: rgba(255, 255, 255, 0.75);
    background: rgba(20, 24, 26, 0.55);
  }

  .shot__credit :global(a:hover) {
    color: #fff;
  }

  /* ---------- Formulario de agenda ---------- */
  .agenda {
    background: var(--white);
    border: 1px solid var(--rule);
    padding: 34px 32px;
  }

  .agenda__title {
    font-family: Newsreader, serif;
    font-weight: 500;
    font-size: 24px;
    letter-spacing: -0.4px;
    margin-bottom: 6px;
  }

  .agenda__sub {
    font-size: 14px;
    color: var(--faint);
    margin-bottom: 26px;
  }

  .form {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .form[hidden] {
    display: none;
  }

  .g-inputs {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }

  .form label {
    display: flex;
    flex-direction: column;
    gap: 7px;
    font-size: 12px;
    letter-spacing: 0.6px;
    text-transform: uppercase;
    color: var(--faint);
  }

  .form input,
  .form select {
    background: var(--paper);
    border: 1px solid var(--rule-strong);
    padding: 13px 14px;
    font-size: 15px;
    font-family: 'Work Sans', sans-serif;
    letter-spacing: normal;
    text-transform: none;
    color: var(--ink);
    outline: none;
    width: 100%;
    transition: border-color 0.18s ease;
  }

  .form input:focus,
  .form select:focus {
    border-color: var(--petrol);
  }

  .form__sent {
    display: flex;
    align-items: center;
    gap: 10px;
    background: rgba(15, 92, 107, 0.07);
    border: 1px solid rgba(15, 92, 107, 0.25);
    padding: 14px 16px;
    font-size: 14.5px;
    color: var(--petrol);
    margin-top: 16px;
  }

  .form__sent[hidden] {
    display: none;
  }

  /* ---------- Stats ---------- */
  .stats {
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
    background: var(--white);
  }

  .g-stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
  }

  .stat-cell {
    padding: 38px 26px;
    border-right: 1px solid var(--rule);
  }

  .stat-cell:last-child {
    border-right: 0;
  }

  .stat__n {
    font-family: Newsreader, serif;
    font-weight: 500;
    font-size: 44px;
    line-height: 1;
    letter-spacing: -1.4px;
    font-variant-numeric: tabular-nums;
    margin-bottom: 10px;
  }

  .stat__label {
    font-size: 13.5px;
    color: var(--faint);
  }

  /* ---------- Tratamientos ---------- */
  .split {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 30px;
    flex-wrap: wrap;
    margin-bottom: 48px;
    padding-bottom: 24px;
    border-bottom: 1px solid var(--rule-strong);
  }

  .split__main {
    max-width: 560px;
  }

  .split__aside {
    font-size: 16.5px;
    line-height: 1.6;
    color: var(--muted);
    max-width: 300px;
    text-wrap: pretty;
  }

  /* El gap de 1px sobre el fondo hace los hilos entre celdas. */
  .g-serv {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: var(--rule);
  }

  .tcell {
    background: var(--paper);
    padding: 34px 30px;
    transition: background 0.2s ease;
  }

  .tcell:hover {
    background: var(--white);
  }

  .tcell__n {
    font-family: Newsreader, serif;
    font-weight: 400;
    font-size: 15px;
    color: var(--petrol);
    font-variant-numeric: tabular-nums;
    margin-bottom: 20px;
  }

  .tcell__title {
    font-family: Newsreader, serif;
    font-weight: 500;
    font-size: 23px;
    letter-spacing: -0.5px;
    margin-bottom: 10px;
  }

  .tcell__desc {
    font-size: 15.5px;
    line-height: 1.6;
    color: var(--muted);
    text-wrap: pretty;
  }

  /* ---------- Primera visita ---------- */
  .g-visita {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    gap: 56px;
    align-items: center;
  }

  .visita__title {
    margin-bottom: 40px;
  }

  .g-pasos {
    display: flex;
    flex-direction: column;
  }

  .paso {
    display: flex;
    gap: 22px;
    padding: 24px 0;
    border-top: 1px solid var(--rule-strong);
  }

  .paso__n {
    font-size: 11.5px;
    letter-spacing: 1.6px;
    text-transform: uppercase;
    color: var(--faint);
    flex: none;
    width: 62px;
    padding-top: 5px;
  }

  .paso__title {
    font-family: Newsreader, serif;
    font-weight: 500;
    font-size: 22px;
    letter-spacing: -0.4px;
    margin-bottom: 8px;
  }

  .paso__desc {
    font-size: 15.5px;
    line-height: 1.65;
    color: var(--muted);
    text-wrap: pretty;
  }

  /* ---------- Precios ---------- */
  .precios__head {
    max-width: 640px;
    margin-bottom: 46px;
  }

  .g-precios {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr);
    gap: 56px;
    align-items: start;
  }

  .price-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
