---
/**
 * Demo Mendez & Asociados — juridico. Personalidad clasica e institucional.
 * Spectral (serif, con bastardilla en los acentos) + IBM Plex Sans, CERO
 * esquinas redondeadas, reticula de fondo en el hero y trato de usted en toda
 * la copia.
 * Breakpoints propios: 1024 / 720 / 520.
 */
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import VerticeSeal from '../../components/VerticeSeal.astro';
import WhatsApp from '../../components/icons/WhatsApp.astro';
import Arrow from '../../components/icons/Arrow.astro';
import Check from '../../components/icons/Check.astro';
import { WHATSAPP_NUMBER, WHATSAPP_DISPLAY, wa } from '../../config/site';
import {
  stats,
  areas,
  porque,
  equipo,
  garantias,
  areasConsulta,
} from '../../data/demos/juridico';
import fotoHero from '../../assets/juridico-biblioteca.jpg';

const fonts =
  'https://fonts.googleapis.com/css2?family=Spectral:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400&family=IBM+Plex+Sans:wght@400;500;600&display=swap';

const waLink = wa('Buenos días, quisiera consultar por un asunto legal');
---

<BaseLayout
  title="Méndez & Asociados — Estudio jurídico en Melo | Demo de Vértice"
  description="Demo de sitio para estudio jurídico: áreas de práctica, equipo y consulta sin cargo. Ejemplo de diseño a medida hecho por Vértice."
  fonts={fonts}
  themeColor="#14213A"
  noindex
>
  <div class="jur">
    <!-- NAV -->
    <header class="navbar">
      <div class="pad nav">
        <a class="brand" href="#top">
          <span class="brand__rule"></span>
          <span class="brand__text">
            <span class="brand__name">Méndez &amp; Asociados</span>
            <span class="brand__sub">Estudio Jurídico</span>
          </span>
        </a>
        <nav class="nav__links" aria-label="Navegación principal">
          <a href="#areas">Áreas</a>
          <a href="#estudio">El estudio</a>
          <a href="#equipo">Equipo</a>
          <a href="#consulta">Contacto</a>
          <a class="nav__cta" href="#consulta">Consulta gratuita</a>
        </nav>
      </div>
    </header>

    <!-- HERO -->
    <section id="top" class="hero-wrap">
      <div class="hero__grid-pattern" aria-hidden="true"></div>
      <div class="pad hero-block">
        <div class="g-hero">
          <div>
            <p class="eyebrow">
              <span class="eyebrow__rule"></span>
              Más de 20 años de trayectoria
            </p>
            <h1 class="t-h1">
              Defendemos sus derechos con <em>experiencia y compromiso</em>
            </h1>
            <p class="hero__lead">
              Asesoramiento jurídico claro y cercano para personas y empresas. Estudiamos cada caso
              en profundidad para darle la mejor estrategia.
            </p>
            <div class="hero__actions">
              <a class="btn btn--brass btn-w" href="#consulta">
                Agendar consulta
                <Arrow size={16} width={2.2} />
              </a>
              <a class="btn btn--outline btn-w" href="#areas">Ver áreas de práctica</a>
            </div>
          </div>

          <!-- Foto con marco de laton desplazado -->
          <div class="hero__media">
            <div class="hero__frame" aria-hidden="true"></div>
            <figure class="shot">
              <Image
                src={fotoHero}
                alt="Biblioteca jurídica del estudio"
                widths={[420, 640, 900]}
                sizes="(max-width: 1024px) 100vw, 420px"
                class="shot__img"
              />
            </figure>
          </div>
        </div>

        <!-- Metricas separadas por hilos verticales -->
        <div class="g-stats">
          {
            stats.map((st) => (
              <div class="stat-cell">
                <div class="stat__n">{st.n}</div>
                <div class="stat__label">{st.label}</div>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- AREAS -->
    <section id="areas" class="pad block">
      <div class="rv split">
        <div>
          <p class="overline">Lo que hacemos</p>
          <h2 class="t-h2">Áreas de práctica</h2>
        </div>
        <p class="split__aside">Cobertura integral para acompañarlo en cada situación legal.</p>
      </div>

      <div class="g-areas">
        {
          areas.map((a) => (
            <article class="rv acell card-pad">
              <div class="acell__meta">
                <span class="acell__rule"></span>
                <span class="acell__n">{a.n}</span>
              </div>
              <h3 class="acell__title">{a.title}</h3>
              <p class="acell__desc">{a.desc}</p>
            </article>
          ))
        }
      </div>
    </section>

    <!-- EL ESTUDIO -->
    <section id="estudio" class="surface">
      <div class="pad block">
        <div class="rv g-estudio">
          <div>
            <p class="overline">Por qué elegirnos</p>
            <h2 class="t-h2 estudio__title">Un estudio en el que confiar</h2>
            <div class="g-porque">
              {
                porque.map((p) => (
                  <div class="porque">
                    <h3 class="porque__title">{p.title}</h3>
                    <p class="porque__desc">{p.desc}</p>
                  </div>
                ))
              }
            </div>
          </div>

          <blockquote class="quote">
            <p class="quote__text">
              “Cada caso merece que lo estudiemos como si fuera el único.”
            </p>
            <footer class="quote__author">
              <span class="quote__rule"></span>
              <span>
                <span class="quote__name">Dr. Ricardo Méndez</span>
                <span class="quote__role">Socio fundador</span>
              </span>
            </footer>
          </blockquote>
        </div>
      </div>
    </section>

    <!-- EQUIPO -->
    <section id="equipo" class="pad block">
      <div class="rv equipo__head">
        <p class="overline">Quiénes somos</p>
        <h2 class="t-h2 equipo__title">Nuestro equipo</h2>
        <p class="equipo__lead">Profesionales con vocación y dedicación a cada caso.</p>
      </div>
      <div class="g-equipo">
        {
          equipo.map((e) => (
            <article class="rv person card-pad">
              <div class="person__mark">
                <span>{e.ini}</span>
              </div>
              <p class="overline overline--sm">{e.role}</p>
              <h3 class="person__name">{e.name}</h3>
              <p class="person__desc">{e.desc}</p>
            </article>
          ))
        }
      </div>
    </section>

    <!-- CONSULTA -->
    <section id="consulta" class="consulta">
      <div class="pad block">
        <div class="rv g-consulta">
          <div>
            <p class="eyebrow">
              <span class="eyebrow__rule"></span>
              Primera consulta sin cargo
            </p>
            <h2 class="t-h2 consulta__title">Cuéntenos su caso</h2>
            <p class="consulta__lead">
              Analizamos su situación y le decimos con franqueza cómo podemos ayudarlo. Sin
              compromiso.
            </p>

            <div class="garantias">
              {
                garantias.map((g) => (
                  <div class="garantia">
                    <Check size={16} color="#C4A86A" width={2.4} />
                    {g}
                  </div>
                ))
              }
            </div>

            <a class="consulta__wa" href={waLink}>
              <WhatsApp size={18} color="currentColor" />
              O escríbanos al {WHATSAPP_DISPLAY}
            </a>
          </div>

          <div class="formcard card-pad">
            <p class="formcard__title">Solicitar consulta</p>

            <form
              class="form"
              data-wa-form
              data-wa-number={WHATSAPP_NUMBER}
              data-wa-intro="Buenos días, solicito una consulta al estudio."
            >
              <div class="g-inputs">
                <label>
                  Nombre completo *
                  <input
                    type="text"
                    name="nombre"
                    placeholder="Ej. Ricardo Fernández"
                    data-wa-label="Nombre"
                    required
                  />
                </label>
                <label>
                  Teléfono o email *
                  <input
                    type="text"
                    name="contacto"
                    placeholder="099 123 456"
                    data-wa-label="Contacto"
                    required
                  />
                </label>
              </div>
              <label>
                Área de su consulta
                <select name="area" data-wa-label="Área">
                  {areasConsulta.map((a) => <option value={a}>{a}</option>)}
                </select>
              </label>
              <label>
                Describa brevemente su caso
                <textarea
                  name="caso"
                  rows="4"
                  placeholder="Cuéntenos lo esencial. Toda la información es confidencial."
                  data-wa-label="Caso"></textarea>
              </label>
              <button type="submit" class="btn btn--navy">
                Enviar consulta
                <Arrow size={16} width={2.2} />
              </button>
            </form>

            <div class="form__sent" data-wa-sent hidden role="status">
              <Check size={17} color="#9A7B3F" width={2.6} />
              Consulta enviada. Le responderemos en menos de 24 horas hábiles.
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- FOOTER -->
    <footer class="foot">
      <div class="pad foot__inner">
        <div class="g-foot">
          <div>
            <div class="foot__brand">
              <span class="foot__rule"></span>
              <span class="foot__name">Méndez &amp; Asociados</span>
            </div>
            <p class="foot__desc">
              Estudio jurídico en Melo, Cerro Largo. Más de 20 años defendiendo los derechos de
              personas y empresas.
            </p>
          </div>
          <div class="foot__col">
            <span class="foot__col-title">Áreas</span>
            <a href="#areas">Civil</a>
            <a href="#areas">Laboral</a>
            <a href="#areas">Familia</a>
            <a href="#areas">Penal</a>
          </div>
          <div class="foot__col">
            <span class="foot__col-title">Contacto</span>
            <a href={waLink}>{WHATSAPP_DISPLAY}</a>
            <a href="#consulta">Agendar consulta</a>
            <a href="#estudio">25 de Mayo 567, Melo</a>
          </div>
        </div>
        <div class="foot__legal">
          <span>© 2026 Méndez &amp; Asociados — Estudio Jurídico · Melo, Uruguay</span>
          <VerticeSeal color="#9A7B3F" textColor="rgba(244,242,237,.55)" />
        </div>
      </div>
    </footer>
  </div>
</BaseLayout>

<style>
  /* ---------- Tokens propios de Mendez & Asociados ---------- */
  .jur {
    --navy: #14213a;
    --navy-deep: #0f1929;
    --paper: #f4f2ed;
    --white: #fff;
    --brass: #9a7b3f;
    --brass-light: #c4a86a;
    --brass-pale: #e8d9b5;
    --muted: #4b5568;
    --label: #6b7488;

    background: var(--paper);
    color: var(--navy);
    font-family: 'IBM Plex Sans', sans-serif;
    overflow-x: clip;
  }

  .jur :global(a:hover) {
    color: var(--brass);
  }

  .pad {
    max-width: 1200px;
    margin: 0 auto;
    padding-left: 32px;
    padding-right: 32px;
  }

  .block {
    padding-top: 84px;
    padding-bottom: 84px;
  }

  .surface {
    background: var(--white);
    border-top: 1px solid rgba(20, 33, 58, 0.12);
    border-bottom: 1px solid rgba(20, 33, 58, 0.12);
  }

  /* ---------- Tipografia ---------- */
  .t-h1 {
    font-family: Spectral, serif;
    font-weight: 400;
    font-size: 58px;
    line-height: 1.14;
    letter-spacing: -0.8px;
    margin-bottom: 26px;
    max-width: 700px;
    text-wrap: balance;
  }

  .t-h1 em {
    font-style: italic;
    color: var(--brass-light);
  }

  .t-h2 {
    font-family: Spectral, serif;
    font-weight: 400;
    font-size: 42px;
    line-height: 1.12;
    letter-spacing: -0.7px;
    text-wrap: balance;
  }

  .overline {
    font-size: 11.5px;
    letter-spacing: 2.4px;
    text-transform: uppercase;
    color: var(--brass);
    margin-bottom: 14px;
  }

  .overline--sm {
    letter-spacing: 1.4px;
    margin-bottom: 9px;
  }

  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 11px;
    font-size: 11.5px;
    letter-spacing: 2.4px;
    text-transform: uppercase;
    color: var(--brass-light);
    margin-bottom: 28px;
  }

  .eyebrow__rule {
    width: 26px;
    height: 1px;
    background: var(--brass);
  }

  /* ---------- Botones (rectos, sin radio) ---------- */
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 11px;
    font-family: 'IBM Plex Sans', sans-serif;
    font-weight: 600;
    font-size: 15.5px;
    letter-spacing: 0.3px;
    border: none;
    cursor: pointer;
    transition:
      background 0.18s ease,
      color 0.18s ease,
      border-color 0.18s ease;
  }

  .btn--brass {
    background: var(--brass);
    color: var(--navy);
    padding: 16px 30px;
  }

  .btn--brass:hover {
    background: var(--brass-light);
    color: var(--navy);
  }

  .btn--outline {
    padding: 16px 28px;
    border: 1px solid rgba(244, 242, 237, 0.28);
    font-size: 15px;
    font-weight: 500;
    color: var(--paper);
  }

  .btn--outline:hover {
    border-color: var(--brass);
    color: var(--paper);
  }

  .btn--navy {
    background: var(--navy);
    color: var(--paper);
    padding: 16px;
  }

  .btn--navy:hover {
    background: var(--brass);
    color: var(--navy);
  }

  /* ---------- Nav ---------- */
  .navbar {
    background: var(--navy);
    color: var(--paper);
  }

  .nav {
    padding-top: 22px;
    padding-bottom: 22px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .brand__rule {
    width: 2px;
    height: 38px;
    background: var(--brass);
    flex: none;
  }

  .brand__text {
    display: flex;
    flex-direction: column;
    line-height: 1.15;
  }

  .brand__name {
    font-family: Spectral, serif;
    font-weight: 500;
    font-size: 21px;
    letter-spacing: 0.2px;
  }

  .brand__sub {
    font-size: 10px;
    letter-spacing: 2.8px;
    text-transform: uppercase;
    color: rgba(244, 242, 237, 0.55);
    margin-top: 2px;
  }

  .nav__links {
    display: flex;
    align-items: center;
    gap: 26px;
    font-size: 14.5px;
    color: rgba(244, 242, 237, 0.8);
  }

  .nav__cta {
    border: 1px solid var(--brass);
    color: var(--brass-pale);
    padding: 11px 20px;
    font-size: 13.5px;
    font-weight: 500;
    letter-spacing: 0.4px;
    transition:
      background 0.18s ease,
      color 0.18s ease;
  }

  .nav__cta:hover {
    background: var(--brass);
    color: var(--navy);
  }

  /* ---------- Hero ---------- */
  .hero-wrap {
    background: var(--navy);
    color: var(--paper);
    position: relative;
    overflow: hidden;
  }

  /* Reticula sutil de 80x80. */
  .hero__grid-pattern {
    position: absolute;
    inset: 0;
    opacity: 0.055;
    pointer-events: none;
    background-image: url("data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20width%3D%2280%22%20height%3D%2280%22%3E%3Cpath%20d%3D%22M0%2040h80M40%200v80%22%20stroke%3D%22%239A7B3F%22%20stroke-width%3D%221%22%2F%3E%3C%2Fsvg%3E");
  }

  .hero-block {
    position: relative;
    padding-top: 78px;
  }

  .g-hero {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 0.75fr);
    gap: 60px;
    align-items: end;
    padding-bottom: 56px;
  }

  .hero__lead {
    font-size: 18px;
    line-height: 1.7;
    color: rgba(244, 242, 237, 0.72);
    margin-bottom: 38px;
    max-width: 520px;
    text-wrap: pretty;
  }

  .hero__actions {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
  }

  .hero__media {
    position: relative;
  }

  /*
   * Marco de laton al ras de la foto. Antes iba desplazado 14px con un
   * translate: el sobrante colgaba por debajo y por la derecha y se leia como
   * un recuadro vacio suelto, no como un marco. En mobile encima se metia 14px
   * en el margen de la pagina (borde derecho en 372 contra 357 del resto de los
   * bloques), asi que la foto parecia mas ancha que todo lo demas.
   */
  .hero__frame {
    position: absolute;
    inset: -1px;
    border: 1px solid rgba(196, 168, 106, 0.35);
    pointer-events: none;
  }

  .shot {
    position: relative;
    margin: 0;
  }

  .shot :global(.shot__img) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4/5;
    object-fit: cover;
  }

  /* ---------- Metricas del hero ---------- */
  .g-stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 26px;
    padding: 34px 0 44px;
    border-top: 1px solid rgba(244, 242, 237, 0.18);
  }

  .stat-cell {
    padding-left: 24px;
    border-left: 1px solid rgba(244, 242, 237, 0.18);
  }

  .stat__n {
    font-family: Spectral, serif;
    font-weight: 300;
    font-size: 46px;
    line-height: 1;
    letter-spacing: -1px;
    color: var(--brass-light);
    font-variant-numeric: tabular-nums;
    margin-bottom: 7px;
  }

  .stat__label {
    font-size: 13.5px;
    color: rgba(244, 242, 237, 0.6);
  }

  /* ---------- Areas ---------- */
  .split {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 30px;
    flex-wrap: wrap;
    margin-bottom: 46px;
    padding-bottom: 22px;
    border-bottom: 1px solid rgba(20, 33, 58, 0.16);
  }

  .split__aside {
    font-size: 16.5px;
    line-height: 1.65;
    color: var(--muted);
    max-width: 320px;
    text-wrap: pretty;
  }

  /* Hilos de 1px entre celdas via gap sobre fondo. */
  .g-areas {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: rgba(20, 33, 58, 0.14);
  }

  .acell {
    background: var(--paper);
    padding: 34px 30px;
    transition: background 0.2s ease;
  }

  .acell:hover {
    background: var(--white);
  }

  .acell__meta {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 16px;
  }

  .acell__rule {
    width: 18px;
    height: 1px;
    background: var(--brass);
  }

  .acell__n {
    font-family: Spectral, serif;
    font-size: 14px;
    color: var(--brass);
    font-variant-numeric: tabular-nums;
  }

  .acell__title {
    font-family: Spectral, serif;
    font-weight: 500;
    font-size: 23px;
    letter-spacing: -0.2px;
    margin-bottom: 10px;
  }

  .acell__desc {
    font-size: 15.5px;
    line-height: 1.65;
    color: var(--muted);
    text-wrap: pretty;
  }

  /* ---------- El estudio ---------- */
  .g-estudio {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 0.9fr);
    gap: 56px;
    align-items: center;
  }

  .estudio__title {
    margin-bottom: 36px;
  }

  .g-porque {
    display: flex;
    flex-direction: column;
  }

  .porque {
    padding: 24px 0;
    border-top: 1px solid rgba(20, 33, 58, 0.14);
  }

  .porque__title {
    font-family: Spectral, serif;
    font-weight: 500;
    font-size: 22px;
    letter-spacing: -0.2px;
    margin-bottom: 8px;
  }

  .porque__desc {
    font-size: 15.5px;
    line-height: 1.65;
    color: var(--muted);
    text-wrap: pretty;
  }

  .quote {
    padding: 34px 32px;
    background: var(--navy);
    color: var(--paper);
    margin: 0;
  }

  .quote__text {
    font-family: Spectral, serif;
    font-weight: 300;
    font-style: italic;
    font-size: 26px;
    line-height: 1.5;
    margin-bottom: 22px;
    text-wrap: pretty;
  }

  .quote__author {
    display: flex;
    align-items: center;
    gap: 13px;
    padding-top: 20px;
    border-top: 1px solid rgba(244, 242, 237, 0.16);
  }

  .quote__rule {
    width: 2px;
    height: 32px;
    background: var(--brass);
    flex: none;
  }

  .quote__name {
    display: block;
    font-family: Spectral, serif;
    font-weight: 500;
    font-size: 17px;
    line-height: 1.35;
  }

  .quote__role {
    display: block;
    font-size: 13px;
    color: rgba(244, 242, 237, 0.6);
    line-height: 1.35;
  }

  /* ---------- Equipo ---------- */
  .equipo__head {
    max-width: 560px;
    margin-bottom: 44px;
  }

  .equipo__title {
    margin-bottom: 12px;
  }

  .equipo__lead {
    font-size: 16.5px;
    line-height: 1.65;
    color: var(--muted);
  }

  .g-equipo {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 26px;
  }

  .person {
    background: var(--white);
    border: 1px solid rgba(20, 33, 58, 0.12);
    padding: 32px 30px;
  }

  .person__mark {
    width: 56px;
    height: 56px;
    background: var(--navy);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 22px;
  }

  .person__mark span {
    font-family: Spectral, serif;
    font-weight: 400;
    font-size: 20px;
    letter-spacing: 1px;
    color: var(--brass-light);
  }

  .person__name {
    font-family: Spectral, serif;
    font-weight: 500;
